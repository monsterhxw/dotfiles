{
  "env": {
    "ANTHROPIC_CUSTOM_HEADERS": "x-stainless-os: Windows",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1"
  },
  "disableAutoMode": "disable",
  "model": "fable",
  "permissions": {
    "ask": [
      "Bash(*rm *)",
      "Bash(*trash *)",
      "Bash(*sudo *)",
      "Bash(dd *)",
      "Bash(*mkfs*)",
      "Bash(*diskutil *)",
      "Bash(*git push --force*)",
      "Bash(*git push -f*)",
      "Bash(*git reset --hard*)",
      "Bash(*git clean *)",
      "Bash(*chmod -R *)",
      "Bash(*chown -R *)",
      "Edit",
      "Write"
    ],
    "defaultMode": "bypassPermissions",
    "deny": [
      "Agent",
      "WebSearch",
      "WebFetch"
    ]
  },
  "useAutoModeDuringPlan": false
}
